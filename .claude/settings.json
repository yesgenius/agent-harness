{
  "model": "opus",
  "effortLevel": "high",
  "env": {
    "MCP_TIMEOUT": "180000"
  },
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(*)",
      "WebFetch",
      "WebSearch",
      "mcp__chrome-devtools"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)"
    ]
  },
  "enabledMcpjsonServers": [
    "chrome-devtools"
  ]
}
